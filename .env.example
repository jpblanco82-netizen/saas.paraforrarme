# Configuración de la Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Auth, PostgreSQL, RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (Facturación, Muro de Pago y Suscripciones)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_pro_29_monthly
NEXT_PUBLIC_STRIPE_AGENCY_PRICE_ID=price_agency_79_monthly

# Motor de Inteligencia Artificial (Gemini / OpenAI)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Emails Transaccionales (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=onboarding@multicontent.ai

# Inngest (Colas de Tareas Asíncronas)
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
